{
    "kind": "singleType",
    "collectionName": "site_settings",
    "info": {
        "singularName": "site-setting",
        "pluralName": "site-settings",
        "displayName": "Impostazioni del sito"
    },
    "options": {
        "draftAndPublish": true
    },
    "attributes": {
        "siteName": {
            "type": "string",
            "required": true
        },
        "logo": {
            "type": "media",
            "multiple": false,
            "allowedTypes": [
                "images"
            ]
        },
        "favicon": {
            "type": "media",
            "multiple": false,
            "allowedTypes": [
                "images"
            ]
        },
        "email": {
            "type": "email"
        },
        "phone": {
            "type": "string"
        },
        "address": {
            "type": "string"
        },
        "footerText": {
            "type": "text",
            "maxLength": 400
        },
        "social": {
            "type": "component",
            "repeatable": true,
            "component": "shared.link"
        }
    }
}
